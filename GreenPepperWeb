<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Pepper Publica LLP | Where Words Take Root</title>
    <style>
        :root {
            --primary: #1b4d3e;
            --secondary: #2e7d32;
            --accent: #d4af37;
            --light-bg: #f7faf8;
            --dark-text: #1c2826;
            --card-bg: #ffffff;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            scroll-behavior: smooth;
        }
        body {
            background-color: var(--light-bg);
            color: var(--dark-text);
            line-height: 1.65;
        }
        /* Header & Navbar */
        header.navbar {
            background: var(--primary);
            color: white;
            padding: 15px 6%;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            box-shadow: 0 3px 12px rgba(0,0,0,0.15);
        }
        .brand {
            display: flex;
            flex-direction: column;
        }
        .brand h1 {
            font-size: 22px;
            letter-spacing: 0.5px;
            color: #ffffff;
        }
        .brand span {
            font-size: 12px;
            color: var(--accent);
            font-style: italic;
        }
        .nav-links {
            display: flex;
            gap: 18px;
            list-style: none;
            align-items: center;
            flex-wrap: wrap;
        }
        .nav-links a {
            color: #e8f5e9;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.2s;
        }
        .nav-links a:hover {
            color: var(--accent);
        }
        .cart-btn {
            background: var(--accent);
            color: var(--dark-text);
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, rgba(27,77,62,0.94), rgba(20,45,36,0.92)),
                        url('https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=1200&q=80') center/cover;
            color: white;
            text-align: center;
            padding: 80px 20px;
        }
        .hero-badge {
            display: inline-block;
            background: rgba(212, 175, 55, 0.2);
            border: 1px solid var(--accent);
            color: var(--accent);
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 13px;
            margin-bottom: 15px;
        }
        .hero h2 {
            font-size: 36px;
            margin-bottom: 12px;
        }
        .hero p {
            max-width: 760px;
            margin: 0 auto 28px;
            font-size: 17px;
            color: #e0ece8;
        }
        .hero-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn-primary {
            background: var(--accent);
            color: var(--dark-text);
            padding: 12px 24px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
            font-size: 15px;
        }
        .btn-outline {
            background: transparent;
            color: white;
            border: 2px solid white;
            padding: 10px 22px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 15px;
        }

        /* Stats Strip */
        .stats-bar {
            background: white;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 15px;
            padding: 25px 6%;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.04);
        }
        .stat-box h3 {
            font-size: 28px;
            color: var(--primary);
        }
        .stat-box p {
            font-size: 13px;
            color: #555;
            font-weight: 600;
        }

        /* Section Styling */
        section {
            padding: 60px 6%;
        }
        .section-header {
            text-align: center;
            margin-bottom: 40px;
        }
        .section-header h2 {
            font-size: 28px;
            color: var(--primary);
            margin-bottom: 8px;
        }
        .section-header p {
            color: #555;
            max-width: 680px;
            margin: 0 auto;
            font-size: 15px;
        }
        .divider {
            width: 60px;
            height: 4px;
            background: var(--accent);
            margin: 10px auto 0;
        }

        /* Bookstore Section */
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 22px;
        }
        .book-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 14px rgba(0,0,0,0.06);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid #e2ece9;
            transition: transform 0.2s;
        }
        .book-card:hover {
            transform: translateY(-4px);
        }
        .book-cover {
            background: linear-gradient(135deg, #1b4d3e, #2e7d32);
            color: white;
            padding: 30px 20px;
            text-align: center;
            min-height: 170px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }
        .book-genre {
            position: absolute;
            top: 10px;
            right: 10px;
            background: var(--accent);
            color: var(--dark-text);
            font-size: 11px;
            font-weight: bold;
            padding: 3px 9px;
            border-radius: 12px;
        }
        .book-cover h4 {
            font-size: 18px;
            margin-bottom: 6px;
        }
        .book-cover span {
            font-size: 13px;
            opacity: 0.9;
        }
        .book-details {
            padding: 18px;
        }
        .book-price {
            font-size: 19px;
            font-weight: bold;
            color: var(--primary);
            margin: 8px 0 14px;
        }
        .book-actions {
            display: flex;
            gap: 8px;
        }
        .buy-now-btn {
            flex: 1;
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 13px;
        }
        .buy-now-btn:hover {
            background: var(--secondary);
        }
        .add-cart-btn {
            background: #e8f5e9;
            color: var(--primary);
            border: 1px solid var(--primary);
            padding: 10px 12px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 13px;
        }

        /* About & Leadership */
        .about-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 28px;
        }
        .info-box {
            background: white;
            padding: 25px;
            border-radius: 10px;
            border-left: 5px solid var(--primary);
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }
        .info-box h3 {
            color: var(--primary);
            margin-bottom: 10px;
            font-size: 20px;
        }

        /* Services Grid (3A to 3K) */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
            gap: 20px;
        }
        .service-card {
            background: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.05);
            border-top: 4px solid var(--primary);
        }
        .service-card .code-tag {
            display: inline-block;
            background: #e8f5e9;
            color: var(--primary);
            font-weight: bold;
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 8px;
        }
        .service-card h3 {
            font-size: 18px;
            color: var(--primary);
            margin-bottom: 10px;
        }
        .service-card ul {
            padding-left: 18px;
            font-size: 14px;
            color: #444;
        }
        .service-card li {
            margin-bottom: 5px;
        }

        /* Packages & Rate Card Table */
        .table-container {
            overflow-x: auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px;
        }
        th, td {
            padding: 13px 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }
        th {
            background: var(--primary);
            color: white;
        }
        tr:hover {
            background: #f9fbf9;
        }
        .rate-badge {
            font-weight: bold;
            color: var(--primary);
        }

        /* Partners & Governance */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 18px;
        }
        .team-card {
            background: white;
            padding: 18px;
            border-radius: 8px;
            border: 1px solid #e0e8e4;
        }
        .team-card h4 {
            color: var(--primary);
            font-size: 16px;
            margin-bottom: 4px;
        }
        .team-card span {
            display: block;
            font-size: 12px;
            font-weight: bold;
            color: #b58900;
            margin-bottom: 8px;
        }
        .team-card p {
            font-size: 13px;
            color: #555;
        }

        /* Modal for Book Order */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.65);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            padding: 15px;
        }
        .modal-box {
            background: white;
            max-width: 480px;
            width: 100%;
            padding: 25px;
            border-radius: 12px;
            position: relative;
            max-height: 90vh;
            overflow-y: auto;
        }
        .close-modal {
            position: absolute;
            top: 12px;
            right: 15px;
            font-size: 22px;
            border: none;
            background: none;
            cursor: pointer;
        }
        .form-group {
            margin-bottom: 12px;
        }
        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
        }

        footer {
            background: #123329;
            color: #d8e6e1;
            padding: 40px 6% 20px;
            text-align: center;
            font-size: 14px;
        }
        @media (max-width: 650px) {
            .hero h2 { font-size: 26px; }
            .nav-links { margin-top: 10px; gap: 10px; }
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <header class="navbar">
        <div class="brand">
            <h1>GREEN PEPPER PUBLICA LLP</h1>
