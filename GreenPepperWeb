    <script>
        // കമ്പനി പ്രൊഫൈലിലെ പുസ്തകങ്ങളുടെ ലിസ്റ്റ്
        const books = [
            {
                id: 1,
                title: "മഴ പെയ്യിക്കാൻ ആരോ വരുന്നുണ്ട്",
                engTitle: "Mazha Peyyikkan Aaro Varunnund",
                author: "ബിനു ആനമങ്ങാട് (Binu Anamangad)",
                genre: "കവിത (Poetry)",
                price: 160
            },
            {
                id: 2,
                title: "ഫിഷ് തെറാപ്പി",
                engTitle: "Fish Therapy",
                author: "ബിനു ആനമങ്ങാട് (Binu Anamangad)",
                genre: "കവിത (Poetry)",
                price: 150
            },
            {
                id: 3,
                title: "ക്രഷ് ദ ബോട്ടിൽ ആഫ്റ്റർ യൂസ് അഥവാ ഓർമ്മകൾ ചാവേറുന്ന ആകാശക്കപ്പൽ",
                engTitle: "Crush the Bottle After Use...",
                author: "ബിനു ആനമങ്ങാട് (Binu Anamangad)",
                genre: "കവിത (Poetry)",
                price: 180
            },
            {
                id: 4,
                title: "പ്രണയമല്ലാതൊന്നുമില്ലീ ഭൂമിയിൽ",
                engTitle: "Pranayamallathonnumillee Bhoomiyil",
                author: "ബിനു ആനമങ്ങാട് (Binu Anamangad)",
                genre: "കവിത (Poetry)",
                price: 170
            },
            {
                id: 5,
                title: "ഗ്രീൻ പെപ്പർ തിരഞ്ഞെടുത്ത കൃതികൾ (52 Titles Catalogue)",
                engTitle: "Green Pepper Imprint Collection",
                author: "വിവിധ എഴുത്തുകാർ",
                genre: "വിവിധ വിഭാഗങ്ങൾ",
                price: 250
            }
        ];

        let cart = [];

        function renderBooks() {
            const container = document.getElementById('books-container');
            container.innerHTML = '';
            books.forEach(book => {
                const card = document.createElement('div');
                card.className = 'book-card';
                card.innerHTML = `
                    <div>
                        <div class="book-cover">
                            <span class="book-genre">${book.genre}</span>
                            <h4>${book.title}</h4>
                            <span>✍️ ${book.author}</span>
                        </div>
                        <div class="book-details">
                            <div style="font-size:12px; color:#666;">${book.engTitle}</div>
                            <div class="book-price">₹${book.price}</div>
                            <div class="book-actions">
                                <button class="buy-now-btn" onclick="buySingleBook(${book.id})">⚡ ഇപ്പോൾ വാങ്ങുക (Buy Now)</button>
                                <button class="add-cart-btn" onclick="addToCart(${book.id})">+ 🛒</button>
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function addToCart(bookId) {
            const book = books.find(b => b.id === bookId);
            cart.push(book);
            document.getElementById('cart-count').textContent = cart.length;
            alert(`"${book.title}" കാർട്ടിലേക്ക് ചേർത്തു!`);
        }

        function buySingleBook(bookId) {
            const book = books.find(b => b.id === bookId);
            cart = [book];
            document.getElementById('cart-count').textContent = cart.length;
            openCartModal();
        }

        function openCartModal() {
            if (cart.length === 0) {
                alert('നിങ്ങളുടെ കാർട്ടിൽ നിലവിൽ പുസ്തകങ്ങളില്ല. ദയവായി ഒരു പുസ്തകം തിരഞ്ഞെടുക്കുക.');
                return;
            }
            const summaryEl = document.getElementById('order-summary');
            let total = 0;
            let listHtml = '<ul style="padding-left:18px; margin-bottom:8px;">';
            cart.forEach(item => {
                total += item.price;
                listHtml += `<li><strong>${item.title}</strong> - ₹${item.price}</li>`;
            });
            listHtml += `</ul><strong>ആകെ തുക (Total): ₹${total}</strong>`;
            summaryEl.innerHTML = listHtml;
            document.getElementById('order-modal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('order-modal').style.display = 'none';
        }

        function confirmBookOrder(e) {
            e.preventDefault();
            const name = document.getElementById('buyer-name').value;
            const phone = document.getElementById('buyer-phone').value;
            const address = document.getElementById('buyer-address').value;
            const payment = document.getElementById('buyer-payment').value;

            let bookList = cart.map(b => `${b.title} (₹${b.price})`).join(', ');
            let total = cart.reduce((sum, b) => sum + b.price, 0);

            const orderText = `പുതിയ പുസ്തക ഓർഡർ (Green Pepper Publica LLP):\nപുസ്തകങ്ങൾ: ${bookList}\nആകെ തുക: ₹${total}\nപേര്: ${name}\nഫോൺ: ${phone}\nവിലാസം: ${address}\nപേയ്മെന്റ് രീതി: ${payment}`;

            alert('നന്ദി! നിങ്ങളുടെ ഓർഡർ വിവരങ്ങൾ തയ്യാറായിക്കഴിഞ്ഞു:\n\n' + orderText);
            cart = [];
            document.getElementById('cart-count').textContent = '0';
            closeModal();
        }

        function submitEnquiry(e) {
            e.preventDefault();
            const name = document.getElementById('enq-name').value;
            const service = document.getElementById('enq-service').value;
            alert(`നന്ദി ${name}! "${service}" സംബന്ധിച്ച നിങ്ങളുടെ അന്വേഷണം Green Pepper Publica LLP-യിൽ ലഭിച്ചിട്ടുണ്ട്. ഞങ്ങൾ ഉടൻ തന്നെ പ്രൊപ്പോസലുമായി ബന്ധപ്പെടുന്നതാണ്.`);
            e.target.reset();
        }

        renderBooks();
    </script>
